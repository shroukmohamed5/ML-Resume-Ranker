{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resume Ranker Input",
  "type": "object",
  "properties": {
    "vacancy": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "skills": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "required_experience_years": { "type": "integer", "minimum": 0 },
        "location": { "type": "string" },
        "salary_range": {
            "type": "object",
            "properties": {
                "min": { "type": "integer" },
                "max": { "type": "integer" },
                "currency": { "type": "string" }
            }
        }
      },
      "required": ["title", "description"]
    },
    "resumes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "skills": { 
            "type": "array",
            "items": { "type": "string" }
          },
          "experience_years": { "type": "integer", "minimum": 0 },
          "summary": { "type": "string" },
          "education": { "type": "string" },
          "location": { "type": "string" }
        },
        "required": ["id"]
      }
    }
  },
  "required": ["vacancy", "resumes"]
}
